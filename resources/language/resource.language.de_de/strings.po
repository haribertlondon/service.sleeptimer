# Kodi Media Center language file
# Addon Name: Sleep Timer
# Addon id: service.sleeptimer
msgid ""
msgstr ""
"Project-Id-Version: service.sleeptimer\n"
"Report-Msgid-Bugs-To: \n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: de_DE\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgctxt "#32001"
msgid "Timers"
msgstr "Timer"

msgctxt "#32002"
msgid "Sleep time, early TV power-off and volume fade-out"
msgstr "Einschlafzeit, vorzeitiges TV-Aus und Lautstaerke-Ausblendung"

msgctxt "#32003"
msgid "Sleep time"
msgstr "Einschlafzeit"

msgctxt "#32004"
msgid "Volume fade-out"
msgstr "Lautstaerke-Ausblendung"

msgctxt "#32005"
msgid "TV commands"
msgstr "TV-Befehle"

msgctxt "#32006"
msgid "Commands used to switch the TV off and on"
msgstr "Befehle zum Aus- und Einschalten des Fernsehers"

msgctxt "#32007"
msgid "Advanced"
msgstr "Erweitert"

msgctxt "#32008"
msgid "Timing details and troubleshooting"
msgstr "Zeitdetails und Fehlersuche"

msgctxt "#32010"
msgid "Enable sleep timer"
msgstr "Sleeptimer aktivieren"

msgctxt "#32011"
msgid "When disabled the service stays loaded but never intervenes."
msgstr "Deaktiviert bleibt der Dienst geladen, greift aber nie ein."

msgctxt "#32012"
msgid "Sleep after"
msgstr "Einschlafen nach"

msgctxt "#32013"
msgid "Time without user interaction until the volume fade-out begins. Pause, seek, volume changes and key presses restart this timer. Playlist advancement does not."
msgstr "Zeit ohne Benutzerinteraktion bis zum Beginn der Ausblendung. Pause, Spulen, Lautstaerkeaenderungen und Tastendruecke starten den Timer neu, der Wechsel zum naechsten Titel nicht."

msgctxt "#32014"
msgid "{0:d} min"
msgstr "{0:d} Min"

msgctxt "#32015"
msgid "Switch TV off after"
msgstr "TV ausschalten nach"

msgctxt "#32016"
msgid "Switches the TV off while audio keeps playing. 0 disables this stage, in which case the TV goes off together with playback. Values equal to or above the sleep time are also treated as disabled."
msgstr "Schaltet den Fernseher aus, waehrend der Ton weiterlaeuft. 0 deaktiviert diese Stufe, dann geht der Fernseher gemeinsam mit der Wiedergabe aus. Werte ab der Einschlafzeit gelten ebenfalls als deaktiviert."

msgctxt "#32017"
msgid "{0:d} min (0 = off)"
msgstr "{0:d} Min (0 = aus)"

msgctxt "#32018"
msgid "Maximum session length"
msgstr "Maximale Sitzungsdauer"

msgctxt "#32019"
msgid "Hard limit measured from the start of playback that cannot be extended by any interaction. Guarantees a shutdown even if something keeps resetting the sleep timer. 0 disables it."
msgstr "Harte Obergrenze ab Wiedergabestart, die durch keine Interaktion verlaengert werden kann. Erzwingt das Abschalten, selbst wenn etwas den Einschlaftimer dauernd zurueck setzt. 0 deaktiviert sie."

msgctxt "#32020"
msgid "Volume reduction per step"
msgstr "Reduktion pro Schritt"

msgctxt "#32021"
msgid "Percentage points subtracted from the Kodi volume on every step."
msgstr "Prozentpunkte, die pro Schritt von der Kodi-Lautstaerke abgezogen werden."

msgctxt "#32022"
msgid "{0:d} %"
msgstr "{0:d} %"

msgctxt "#32023"
msgid "Step interval"
msgstr "Schrittabstand"

msgctxt "#32024"
msgid "Time between two volume reduction steps."
msgstr "Zeit zwischen zwei Reduktionsschritten."

msgctxt "#32025"
msgid "{0:d} s"
msgstr "{0:d} s"

msgctxt "#32026"
msgid "Notify when fade-out starts"
msgstr "Hinweis beim Start der Ausblendung"

msgctxt "#32027"
msgid "Shows an on-screen message so the fade-out can be cancelled even when the TV is already off."
msgstr "Zeigt eine Meldung, damit die Ausblendung auch bei ausgeschaltetem Fernseher abgebrochen werden kann."

msgctxt "#32030"
msgid "TV off command"
msgstr "TV-Aus-Befehl"

msgctxt "#32031"
msgid "A SINGLE command that sends the TV power code once, e.g. 'ir-ctl -S nec:0x408 -d /dev/lirc0'. Do not put a retry loop here: the addon handles retries and can cancel them. A loop would keep toggling the TV on and off."
msgstr "EIN EINZELNER Befehl, der den Einschaltcode genau einmal sendet, z. B. 'ir-ctl -S nec:0x408 -d /dev/lirc0'. Hier darf keine Wiederholungsschleife stehen: Wiederholungen verwaltet das Addon und kann sie abbrechen. Eine Schleife wuerde den Fernseher dauernd ein- und ausschalten."

msgctxt "#32032"
msgid "TV on command"
msgstr "TV-Ein-Befehl"

msgctxt "#32033"
msgid "Command that switches the TV on. Leave empty to use CEC (CECActivateSource)."
msgstr "Befehl zum Einschalten des Fernsehers. Leer lassen, um CEC zu verwenden."

msgctxt "#32034"
msgid "Command type"
msgstr "Befehlsart"

msgctxt "#32035"
msgid "Run the commands as a Kodi builtin or as a shell command."
msgstr "Befehle als Kodi-Builtin oder als Shell-Befehl ausfuehren."

msgctxt "#32036"
msgid "Kodi builtin"
msgstr "Kodi-Builtin"

msgctxt "#32037"
msgid "Shell command"
msgstr "Shell-Befehl"

msgctxt "#32040"
msgid "Playback stop grace period"
msgstr "Karenzzeit nach Wiedergabeende"

msgctxt "#32041"
msgid "How long playback may be absent before the session is considered over. Must stay above the gap between two playlist items."
msgstr "Wie lange keine Wiedergabe laufen darf, bevor die Sitzung als beendet gilt. Muss groesser sein als die Luecke zwischen zwei Playlist-Eintraegen."

msgctxt "#32042"
msgid "Delay before restoring the volume"
msgstr "Verzoegerung vor Lautstaerke-Wiederherstellung"

msgctxt "#32043"
msgid "Waiting time after stopping playback, so that restoring the volume stays silent."
msgstr "Wartezeit nach dem Stoppen, damit das Zuruecksetzen der Lautstaerke lautlos bleibt."

msgctxt "#32046"
msgid "React to"
msgstr "Reagieren auf"

msgctxt "#32047"
msgid "Whether only video playback or any playback starts a session."
msgstr "Ob nur Videowiedergabe oder jede Wiedergabe eine Sitzung startet."

msgctxt "#32048"
msgid "Video only"
msgstr "Nur Video"

msgctxt "#32049"
msgid "Any playback"
msgstr "Jede Wiedergabe"

msgctxt "#32050"
msgid "Verbose logging"
msgstr "Ausfuehrliche Protokollierung"

msgctxt "#32051"
msgid "Writes state changes, activity decisions and a periodic countdown to the Kodi log."
msgstr "Schreibt Zustandswechsel, Aktivitaetsentscheidungen und einen regelmaessigen Countdown ins Kodi-Log."

msgctxt "#32052"
msgid "Heartbeat interval"
msgstr "Heartbeat-Intervall"

msgctxt "#32053"
msgid "How often the remaining time is written to the log while verbose logging is on."
msgstr "Wie oft die Restzeit ins Log geschrieben wird, solange die ausfuehrliche Protokollierung aktiv ist."

msgctxt "#32060"
msgid "TV off verification"
msgstr "TV-Aus-Ueberpruefung"

msgctxt "#32061"
msgid "Verify command"
msgstr "Pruefbefehl"

msgctxt "#32062"
msgid "Optional shell command that exits with 0 when the TV is off, e.g. 'cec-ctl -S | grep -q Standby'. Only when this is set will the power code be sent more than once. Leave empty to send exactly one toggle."
msgstr "Optionaler Shell-Befehl, der mit 0 endet, wenn der Fernseher aus ist, z. B. 'cec-ctl -S | grep -q Standby'. Nur wenn dieser gesetzt ist, wird der Einschaltcode mehrmals gesendet. Leer lassen, um genau einmal zu senden."

msgctxt "#32063"
msgid "Maximum retries"
msgstr "Maximale Wiederholungen"

msgctxt "#32064"
msgid "How often the power code may be re-sent when verification says the TV is still on. Bounded on purpose: each send toggles the TV."
msgstr "Wie oft der Einschaltcode erneut gesendet werden darf, wenn die Pruefung meldet, dass der Fernseher noch laeuft. Absichtlich begrenzt: jedes Senden schaltet um."

msgctxt "#32065"
msgid "{0:d} x"
msgstr "{0:d} x"

msgctxt "#32066"
msgid "Retry interval"
msgstr "Wiederholungsabstand"

msgctxt "#32067"
msgid "Waiting time between sending the power code and verifying the result."
msgstr "Wartezeit zwischen dem Senden des Einschaltcodes und der Pruefung."

msgctxt "#32068"
msgid "Command timeout"
msgstr "Befehls-Zeitlimit"

msgctxt "#32069"
msgid "A TV command that hangs longer than this is killed."
msgstr "Ein TV-Befehl, der laenger haengt, wird beendet."

msgctxt "#32100"
msgid "Sleeping in %d s - press any key to cancel"
msgstr "Abschalten in %d s - Taste druecken zum Abbrechen"

