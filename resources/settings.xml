          <constraints>
            <minimum>1</minimum>
            <step>1</step>
            <maximum>60</maximum>
          </constraints>
          <control type="slider" format="integer">
            <popup>false</popup>
            <formatlabel>32025</formatlabel>
          </control>
        </setting>
        <setting id="notify_on_ramp" type="boolean" label="32026" help="32027">
          <level>0</level>
          <default>true</default>
