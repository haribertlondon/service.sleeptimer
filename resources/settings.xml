<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings version="1">
  <section id="service.sleeptimer">

    <category id="timers" label="32001" help="32002">
      <group id="1" label="32003">
        <setting id="enabled" type="boolean" label="32010" help="32011">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="movie_sleep_timer" type="integer" label="32012" help="32013">
          <level>0</level>
          <default>45</default>
          <constraints>
            <minimum>5</minimum>
            <step>5</step>
            <maximum>180</maximum>
          </constraints>
          <dependencies>
            <dependency type="enable" setting="enabled" operator="is">true</dependency>
          </dependencies>
          <control type="slider" format="integer">
            <popup>false</popup>
            <formatlabel>32014</formatlabel>
          </control>
        </setting>
        <setting id="tv_off_timer" type="integer" label="32015" help="32016">
          <level>0</level>
          <default>0</default>
          <constraints>
            <minimum>0</minimum>
            <step>5</step>
            <maximum>180</maximum>
          </constraints>
          <dependencies>
            <dependency type="enable" setting="enabled" operator="is">true</dependency>
          </dependencies>
          <control type="slider" format="integer">
            <popup>false</popup>
            <formatlabel>32017</formatlabel>
          </control>
